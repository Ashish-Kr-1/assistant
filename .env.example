# Charaka IP Environment Configuration

# Server Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ipsakti_secret_pass

# LLM & Embedding Models
LLM_PROVIDER=cohere  # Options: 'cohere' (default for prototype), 'openai', 'gemini', 'auto'
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Cohere Embed (semantic retrieval) - uses COHERE_API_KEY above
# Model: embed-multilingual-v3.0 (1024-dim, supports 100+ languages including Hindi/Tamil)
# If COHERE_API_KEY is unset, system falls back to hash-based offline embedding for dev/tests.
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# Maximal Marginal Relevance (MMR) for Semantic Search Diversification
USE_MMR=true         # true: apply MMR to eliminate redundant clauses; false: pure hybrid rank
MMR_LAMBDA=0.7       # 1.0 = pure query relevance; 0.0 = maximal diversity; 0.7 = recommended balance

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# Bhashini (National Language Translation Infrastructure)
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_USER_ID=

# Live Web Research (ml_pipeline/agents/web_research_agent.py — ported from the "Charak IP"
# prototype). Powers the multilingual detection + live-cited web-search fallback that kicks in
# when the local verified corpus returns a LOW-confidence or abstained answer. If unset, this
# feature quietly no-ops and the app behaves exactly as it does today.
TAVILY_API_KEY=

# External Legal APIs
INPASS_API_ENDPOINT=https://ipindiaservices.gov.in/public-search
WIPO_LEX_API_ENDPOINT=https://wipolex.wipo.int/api/v1

# Relational Database (PostgreSQL)
POSTGRES_USER=ipsakti
POSTGRES_PASSWORD=ipsakti_db_pass
POSTGRES_DB=ipsakti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
